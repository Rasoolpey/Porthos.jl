{
 "description": "IEEE39 PF-matched true-PH -- no fault, equilibrium gate",
 "system": "system_phtrue.json",
 "solver": {
  "method": "ida",
  "dt": 0.0005,
  "duration": 20.0
 },
 "output": {
  "directory": "outputs/IEEE39Bus_PF_nofault"
 },
 "plots": [
  {
   "title": "Rotor / converter phase angles",
   "y_label": "angle [deg, wrapped]",
   "signals": [
    {
     "pattern": "GENROU*delta_deg"
    },
    {
     "pattern": "*theta_deg"
    }
   ]
  },
  {
   "title": "Rotor Speeds",
   "y_label": "omega [pu]",
   "signals": [
    {
     "pattern": "GENROU*omega"
    },
    {
     "pattern": "GFM*omega"
    },
    {
     "pattern": "GFL*omega"
    },
    {
     "pattern": "*f_meas"
    }
   ]
  },
  {
   "title": "Terminal Voltages",
   "y_label": "Vterm [pu]",
   "signals": [
    {
     "pattern": "Vterm_Bus*"
    }
   ]
  },
  {
   "title": "Reservoir Energies",
   "y_label": "H [pu]",
   "signals": [
    {
     "pattern": "*H_steam"
    },
    {
     "pattern": "*H_water"
    },
    {
     "pattern": "*H_field"
    }
   ]
  }
 ]
}