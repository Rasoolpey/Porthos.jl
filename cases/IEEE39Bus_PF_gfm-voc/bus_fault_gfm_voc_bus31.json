{
 "description": "IEEE39 PF-matched -- 3ph fault at Bus 31 (PF CCT anchor)",
 "system": "system_gfm_voc.json",
 "solver": {
  "method": "ida",
  "dt": 0.0005,
  "duration": 15.0
 },
 "events": [
  {
   "type": "BusFault",
   "bus": 31,
   "r": 0.0001,
   "x": 0.0001,
   "t_start": 1.0,
   "t_duration": 0.15
  }
 ],
 "output": {
  "directory": "outputs/IEEE39Bus_PF_gfm_voc_fault_bus31"
 },
 "plots": [
  {
   "title": "Rotor / converter phase angles",
   "y_label": "angle [deg, wrapped]",
   "signals": [
    {
     "pattern": "GENROU*delta_deg"
    },
    {
     "pattern": "*theta_deg"
    }
   ]
  },
  {
   "title": "Rotor Speeds",
   "y_label": "omega [pu]",
   "signals": [
    {
     "pattern": "GENROU*omega"
    },
    {
     "pattern": "GFM*omega"
    },
    {
     "pattern": "GFL*omega"
    },
    {
     "pattern": "*f_meas"
    }
   ]
  },
  {
   "title": "Terminal Voltages",
   "y_label": "Vterm [pu]",
   "signals": [
    {
     "pattern": "Vterm_Bus*"
    }
   ]
  },
  {
   "title": "Reservoir Energies",
   "y_label": "H [pu]",
   "signals": [
    {
     "pattern": "*H_steam"
    },
    {
     "pattern": "*H_water"
    },
    {
     "pattern": "*H_field"
    }
   ]
  }
 ]
}