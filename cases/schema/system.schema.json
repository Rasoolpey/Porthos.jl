{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://github.com/Rasoolpey/Porthos.jl/cases/schema/system.schema.json",
 "title": "Porthos / PHPS system case",
 "description": "System file: network tables, dynamic components and their wiring. Same format as PHPS (phps/cases). Keys starting with '_' and other extra keys are provenance and are kept but not interpreted.",
 "type": "object",
 "required": ["Bus", "Line", "components", "connections"],
 "properties": {
  "description": {"type": "string"},
  "config": {
   "type": "object",
   "properties": {
    "mva_base": {"type": "number", "exclusiveMinimum": 0},
    "fn": {"type": "number", "exclusiveMinimum": 0},
    "omega_b": {"$ref": "#/definitions/param"},
    "skip_pf_solve": {"type": "boolean"},
    "kpf": {"type": "number"},
    "kqf": {"type": "number"},
    "description": {"type": "string"}
   }
  },
  "Bus": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["idx"],
    "properties": {
     "idx": {"type": "integer"},
     "name": {"type": "string"},
     "Vn": {"type": "number"},
     "v0": {"type": "number"},
     "a0": {"type": "number"},
     "vmax": {"type": "number"},
     "vmin": {"type": "number"},
     "area": {"type": "integer"},
     "zone": {"type": "integer"}
    }
   }
  },
  "PQ": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["idx", "bus"],
    "properties": {
     "idx": {"$ref": "#/definitions/id"},
     "bus": {"type": "integer"},
     "p0": {"type": "number"},
     "q0": {"type": "number"},
     "Vn": {"type": "number"}
    }
   }
  },
  "PV": {"type": "array", "items": {"$ref": "#/definitions/source"}},
  "Slack": {
   "type": "array",
   "items": {
    "allOf": [
     {"$ref": "#/definitions/source"},
     {"properties": {"a0": {"type": "number"}}}
    ]
   }
  },
  "Line": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["idx", "bus1", "bus2"],
    "properties": {
     "idx": {"$ref": "#/definitions/id"},
     "bus1": {"type": "integer"},
     "bus2": {"type": "integer"},
     "r": {"type": "number"},
     "x": {"type": "number"},
     "b": {"type": "number"},
     "g": {"type": "number"},
     "tap": {"type": "number", "exclusiveMinimum": 0},
     "phi": {"type": "number"},
     "trans": {"type": "integer"},
     "Vn1": {"type": "number"},
     "Vn2": {"type": "number"},
     "npar": {"type": "integer"}
    }
   }
  },
  "Shunt": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["bus"],
    "properties": {
     "idx": {"$ref": "#/definitions/id"},
     "bus": {"type": "integer"},
     "g": {"type": "number"},
     "b": {"type": "number"},
     "Vn": {"type": "number"}
    }
   }
  },
  "components": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": ["type", "params"],
    "properties": {
     "type": {"type": "string", "minLength": 1},
     "params": {
      "type": "object",
      "additionalProperties": {"type": ["number", "string", "boolean", "null", "array", "object"]}
     }
    }
   }
  },
  "connections": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["from", "to"],
    "properties": {
     "from": {"type": "string", "minLength": 1},
     "to": {"type": "string", "pattern": "^[^.]+\\.[^.]+$"}
    }
   }
  }
 },
 "definitions": {
  "id": {"type": ["integer", "string"]},
  "param": {
   "description": "A number, or an arithmetic expression over numbers and the constants M_PI / pi (read by the Porthos expression reader, never eval).",
   "type": ["number", "string"]
  },
  "source": {
   "type": "object",
   "required": ["bus"],
   "properties": {
    "idx": {"$ref": "#/definitions/id"},
    "bus": {"type": "integer"},
    "p0": {"type": "number"},
    "q0": {"type": "number"},
    "v0": {"type": "number"},
    "Sn": {"type": "number"},
    "Vn": {"type": "number"},
    "pmax": {"type": "number"},
    "pmin": {"type": "number"},
    "qmax": {"type": "number"},
    "qmin": {"type": "number"}
   }
  }
 }
}
